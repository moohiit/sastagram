# --- Server ---
PORT=8000
# Frontend origin allowed by CORS (dev: http://localhost:5173, prod: https://sastagram.mohitpatel.org)
URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sastagram

# --- Auth ---
# Long random string, e.g. run: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

# --- Cloudinary (dashboard -> Account Details) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Set by the platform in production (Render sets this automatically)
# NODE_ENV=production

# --- AI features (optional; features hidden when absent) ---
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Web push notifications (optional; feature hidden when absent) ---
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:mohit.patel.edu@gmail.com

# --- Optional: Redis adapter for multi-instance socket.io scaling ---
# REDIS_URL=redis://localhost:6379
